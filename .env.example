# Supabase Connect → Session pooler (5432). Replace password; URL-encode special characters.
DATABASE_URL=
# Secret OpenAI key. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional secret Claude key. With it, OpenAI researches and audits while Claude writes and revises.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# FLOWERS_REPO=/absolute/path/to/flowers

# Photos follow each article’s format snapshot (default two); generated server-side and optimized to WebP.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# GitHub access for project onboarding and cloud publishing. Keep this server-side.
# Fine-grained token: only selected client repositories, Contents read/write.
GITHUB_PROJECTS_TOKEN=

# Always-on worker (npm run worker, e.g. on Railway): projects processed in parallel and seconds between passes.
# WORKER_CONCURRENCY=3
# WORKER_INTERVAL_SECONDS=60

# Hosted admin only. Configure in the hosting dashboard, never commit values.
# ADMIN_HOSTED=true
# ADMIN_ORIGIN=https://your-admin-domain.com
# Railway supplies RAILWAY_PUBLIC_DOMAIN once a domain is generated; ADMIN_ORIGIN overrides it (custom domain).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
