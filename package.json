{
  "name": "inspirovate-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "start:server": "node scripts/start-server.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/db-migrate.ts",
    "scheduler": "node --env-file=.env.local --import tsx scripts/scheduler.ts",
    "scheduler:once": "node --import tsx scripts/scheduler-once.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "luxon": "^3.7.2",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-admin": "5.15.4",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
